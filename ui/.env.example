# Frontend Environment Variables
# Para desarrollo local, estas variables se pueden dejar vacías o apuntar a localhost
# Vite automáticamente usa http://localhost:3000/api en desarrollo

# En producción, estas URLs deben apuntar a tus servicios de Cloud Run
VITE_API_URL=https://ponti-api-dev-XXXXX.us-central1.run.app
VITE_AUTH_API_URL=https://auth-api-dev-XXXXX.us-central1.run.app
